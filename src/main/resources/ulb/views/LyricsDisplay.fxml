<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1"
           fx:controller="ulb.views.playboxes.LyricsDisplayView" translateY="18" translateX="8">
    <VBox prefHeight="31.0" prefWidth="200.0" style="-fx-background-color: #131318;">
        <Button fx:id="toggleModeButton" onAction="#handleToggleMode" prefHeight="29.0" prefWidth="201.0"
                style="-fx-background-color: #1DB954;">
            <graphic>
                <ImageView fx:id="toggleIconImage" fitHeight="20" fitWidth="20" preserveRatio="true">
                    <Image url="@../../images/micro.png"/>
                </ImageView>
            </graphic>
        </Button>
        <ScrollPane fitToWidth="true" prefWidth="200.0" style="-fx-background-color: #131318;" styleClass="scroll-pane"
                    stylesheets="@../../style/style.css" VBox.vgrow="ALWAYS">
            <VBox fx:id="lyricsContainer" spacing="5" style="-fx-background-color: #131318; -fx-padding: 10;"/>
        </ScrollPane>
    </VBox>
</StackPane>
