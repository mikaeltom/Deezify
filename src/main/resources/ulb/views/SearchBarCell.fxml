<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<HBox xmlns:fx="http://javafx.com/fxml/1" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity"
      minWidth="-Infinity"
      prefHeight="40.0" prefWidth="220.0" xmlns="http://javafx.com/javafx/21.0.6"
      fx:controller="ulb.views.searches.SearchBarCellView"
      styleClass="search-bar-cell"
      stylesheets="@../../style/style.css">
    <VBox.margin>
        <Insets bottom="4.0"/>
    </VBox.margin>
    <HBox fillHeight="false" prefHeight="38.0" prefWidth="219.0"
          style="-fx-background-color: #1A1D20; -fx-background-radius: 10; -fx-border-radius: 10;">
        <Label fx:id="musicName" prefHeight="38.0" prefWidth="146.0" text="Name_Song"
               stylesheets="@../../style/style.css" styleClass="search-bar-song-label">
            <HBox.margin>
                <Insets left="5.0"/>
            </HBox.margin>
            <font>
                <Font name="Arial" size="14.0"/>
            </font>
        </Label>
        <Button fx:id="playMusicButton" contentDisplay="GRAPHIC_ONLY" mnemonicParsing="false"
                styleClass="button-icon"
                onMouseClicked="#onButtonPlayMusic" prefHeight="30.0" prefWidth="30.0"
                stylesheets="@../../style/style.css"
                style="-fx-background-color: #1A1D20; -fx-border-color: #1A1D20;-fx-background-radius: 10; -fx-border-radius: 10;">
            <graphic>
                <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                    <Image url="@/images/play.png"/>
                </ImageView>
            </graphic>
            <HBox.margin>
                <Insets left="20.0" top="5.0"/>
            </HBox.margin>
        </Button>
    </HBox>
    <HBox prefHeight="38.0" prefWidth="47.0"
          style="-fx-background-color: #1A1D20; -fx-background-radius: 10; -fx-border-radius: 10;">
        <Button fx:id="tripleDotButton" alignment="TOP_RIGHT" contentDisplay="GRAPHIC_ONLY"
                mnemonicParsing="false" onMouseClicked="#openSongOption" prefHeight="15.0"
                styleClass="button-icon"
                prefWidth="23.0"
                style="-fx-border-color: #1A1D20; -fx-background-color: #1A1D20; -fx-background-radius: 10; -fx-border-radius: 10;">
            <graphic>
                <ImageView fitHeight="20.0" fitWidth="23.0" pickOnBounds="true" preserveRatio="true">
                    <Image url="@/images/tripledot.png"/>
                </ImageView>
            </graphic>
            <HBox.margin>
                <Insets left="5.0" right="4.0" top="5.0"/>
            </HBox.margin>
        </Button>
        <Button fx:id="heartButton" alignment="TOP_RIGHT" contentDisplay="GRAPHIC_ONLY"
                layoutY="-10.0"
                prefHeight="20.0" prefWidth="23.0"
                onMouseClicked="#handleHeartClick"
                styleClass="button-icon"
                style="-fx-background-color: #1A1D20; -fx-border-color: #1A1D20; -fx-background-radius: 10; -fx-border-radius: 10;">
            <graphic>
                <ImageView fx:id="heartImageView" fitHeight="20.0" fitWidth="20.0" pickOnBounds="true"
                           preserveRatio="true">
                    <Image url="@/images/heart-outline.png"/>
                </ImageView>
            </graphic>
            <HBox.margin>
                <Insets left="5.0" right="4.0" top="5.0"/>
            </HBox.margin>
        </Button>
    </HBox>
</HBox>
