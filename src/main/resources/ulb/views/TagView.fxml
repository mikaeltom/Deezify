<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1" prefHeight="417.0"
            prefWidth="303.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            fx:controller="ulb.views.options.TagView"
            stylesheets="@../../style/style.css"
            styleClass="tag-pane">

    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>

    <VBox alignment="CENTER" spacing="10.0" prefWidth="280.0" styleClass="tag-container"
          AnchorPane.topAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0">

        <Label text="%predefined_tags" styleClass="option-label"/>
        <AnchorPane prefHeight="100.0">
            <ScrollPane fx:id="predefinedTagScrollPane" fitToWidth="true" prefHeight="95.0" prefWidth="280.0"
                        styleClass="scroll-pane">
                <FlowPane fx:id="predefinedTagFlowPane" hgap="5" vgap="5" prefWrapLength="260.0">
                    <ToggleButton text="Alternative" styleClass="tag-button"/>
                    <ToggleButton text="AfroBeat" styleClass="tag-button"/>
                    <ToggleButton text="Blues" styleClass="tag-button"/>
                    <ToggleButton text="Country" styleClass="tag-button"/>
                    <ToggleButton text="Dance" styleClass="tag-button"/>
                    <ToggleButton text="Disco" styleClass="tag-button"/>
                    <ToggleButton text="Drill" styleClass="tag-button"/>
                    <ToggleButton text="Folk" styleClass="tag-button"/>
                    <ToggleButton text="Hip-hop" styleClass="tag-button"/>
                    <ToggleButton text="House" styleClass="tag-button"/>
                    <ToggleButton text="Jazz" styleClass="tag-button"/>
                    <ToggleButton text="Latin" styleClass="tag-button"/>
                    <ToggleButton text="Metal" styleClass="tag-button"/>
                    <ToggleButton text="Pop" styleClass="tag-button"/>
                    <ToggleButton text="Punk" styleClass="tag-button"/>
                    <ToggleButton text="Rap" styleClass="tag-button"/>
                    <ToggleButton text="Reggae" styleClass="tag-button"/>
                    <ToggleButton text="RnB" styleClass="tag-button"/>
                    <ToggleButton text="Rock" styleClass="tag-button"/>
                    <ToggleButton text="Soul" styleClass="tag-button"/>
                    <ToggleButton text="Trap" styleClass="tag-button"/>

                </FlowPane>
            </ScrollPane>
        </AnchorPane>

        <Label text="%custom_tags" styleClass="option-label"/>
        <AnchorPane prefHeight="80.0">
            <ScrollPane fx:id="customTagScrollPane" fitToWidth="true" prefHeight="40.0" prefWidth="280.0"
                        styleClass="scroll-pane">
                <FlowPane fx:id="customTagFlowPane" hgap="5" vgap="5"/>
            </ScrollPane>
        </AnchorPane>

        <HBox spacing="10.0" alignment="CENTER">
            <TextField fx:id="tagTextField" prefWidth="200.0" promptText="%ask_new_tag"
                       styleClass="option-text-field"/>
            <Button fx:id="submitTagButton" onAction="#handleCustomTagSubmit" text="%add"
                    styleClass="option-button"/>
        </HBox>

    </VBox>

    <VBox alignment="CENTER" spacing="10.0"
          AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0"
          prefWidth="280.0">
        <HBox alignment="CENTER">
            <Button fx:id="closeButton" text="%close" onAction="#handleClose" prefWidth="100.0"
                    styleClass="option-button"/>
        </HBox>
    </VBox>

</AnchorPane>
