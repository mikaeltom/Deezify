<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1" prefHeight="254.0" prefWidth="70.0"
            styleClass="option-pane"
            stylesheets="@../../style/style.css"
            xmlns="http://javafx.com/javafx/23.0.1"
            fx:controller="ulb.views.accounts.ChooseLanguageView">
    <VBox alignment="TOP_CENTER" layoutY="17.0" prefHeight="220.0" prefWidth="239.0">

        <Label fx:id="languageLabel" prefHeight="30.0" prefWidth="223.0"
               styleClass="option-label" text="%choose_language"/>

        <Button fx:id="frenchButton" mnemonicParsing="false" styleClass="option-button"
                text="%french" onAction="#handleChangeToFrench">
            <VBox.margin>
                <Insets top="20.0"/>
            </VBox.margin>
        </Button>


        <Button fx:id="englishButton" mnemonicParsing="false" styleClass="option-button"
                text="%english" onAction="#handleChangeToEnglish">
            <VBox.margin>
                <Insets top="20.0"/>
            </VBox.margin>
        </Button>

        <Button fx:id="netherlandsButton" mnemonicParsing="false" styleClass="option-button"
                text="%dutch" onAction="#handleChangeToDutch">
            <VBox.margin>
                <Insets top="20.0"/>
            </VBox.margin>
        </Button>

    </VBox>
</AnchorPane>
