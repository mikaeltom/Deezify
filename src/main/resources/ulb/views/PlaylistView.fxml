<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1" prefHeight="417.0" prefWidth="329.0"
            style="-fx-background-color: #131318;" xmlns="http://javafx.com/javafx/23.0.1"
            fx:controller="ulb.views.options.PlaylistOptionsView">

    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>

    <VBox alignment="CENTER" layoutX="30.0" layoutY="30.0" prefHeight="233.0" prefWidth="324.0" spacing="10.0"
          styleClass="custom-playlist-vbox" stylesheets="@../../style/style.css" AnchorPane.leftAnchor="10.0"
          AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="10.0">

        <Label alignment="CENTER" prefHeight="7.0" prefWidth="287.0" styleClass="custom-playlist-vbox-title"
               stylesheets="@../../style/style.css" text="%custom_playlist" textAlignment="CENTER"/>
        <AnchorPane prefHeight="80.0">
            <ScrollPane fx:id="customPlaylistScrollPane" fitToWidth="true" prefHeight="100.0" prefWidth="280.0">
                <FlowPane fx:id="customPlaylistFlowPane" hgap="5" vgap="5"/>
            </ScrollPane>
        </AnchorPane>

        <HBox alignment="CENTER" spacing="10.0">
            <TextField fx:id="playlistTextField" prefHeight="44.0" prefWidth="177.0" promptText="%ask_new_playlist"
                       style="-fx-font-size: 12;" styleClass="custom-add-vbox-text-field"
                       stylesheets="@../../style/style.css"/>
            <Button fx:id="submitPlaylistButton" onAction="#handleCustomPlaylistSubmit" prefHeight="41.0"
                    prefWidth="86.0" style="-fx-font-size: 11;" styleClass="playlist-add-button"
                    stylesheets="@../../style/style.css" text="%add"/>
        </HBox>

    </VBox>

    <VBox alignment="CENTER" prefWidth="280.0" spacing="10.0" AnchorPane.bottomAnchor="10.0"
          AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0">
        <HBox alignment="CENTER">
            <Button fx:id="closeButton" onAction="#handleClose" prefWidth="100.0" styleClass="playlist-add-button"
                    stylesheets="@../../style/style.css" text="%close"/>
        </HBox>
    </VBox>


</AnchorPane>
