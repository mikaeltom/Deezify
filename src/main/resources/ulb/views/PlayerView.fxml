<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<VBox xmlns:fx="http://javafx.com/fxml/1" alignment="BOTTOM_CENTER" spacing="5.0"
      xmlns="http://javafx.com/javafx/21.0.6" fx:controller="ulb.views.PlayerView">
    <HBox alignment="CENTER" spacing="10.0">
        <Button fx:id="previousButton" mnemonicParsing="false" onAction="#setUpPreviousButton" prefHeight="39.0"
                prefWidth="41.0" styleClass="button-icon-no-background" stylesheets="@../../style/style.css">
            <graphic>
                <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                    <Image url="@../../images/previous-song-icon.png"/>
                </ImageView>
            </graphic>
        </Button>
        <Button fx:id="pauseButton" mnemonicParsing="false" onAction="#setUpPauseButton" prefHeight="19.0"
                prefWidth="28.0" styleClass="button-icon-no-background" stylesheets="@../../style/style.css">
            <graphic>
                <ImageView fx:id="nextButtonIcon" fitHeight="40.0" fitWidth="40.0" pickOnBounds="true"
                           preserveRatio="true">
                    <Image url="@../../images/play.png"/>
                </ImageView>
            </graphic>
        </Button>
        <Button fx:id="nextButton" mnemonicParsing="false" onAction="#setUpNextButton" prefHeight="42.0"
                prefWidth="27.0" styleClass="button-icon-no-background" stylesheets="@../../style/style.css">
            <graphic>
                <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                    <Image url="@../../images/skip-song-icon.png"/>
                </ImageView>
            </graphic>
        </Button>
    </HBox>
    <HBox alignment="CENTER">
        <Text fx:id="currentSongTime" fill="#1db954" strokeType="OUTSIDE" strokeWidth="0.0" text="0:00"/>
        <Slider fx:id="progressBar" prefHeight="16.0" prefWidth="170.0" stylesheets="@../../style/style.css"/>
        <Text fx:id="totalSongTime" fill="#1db954" strokeType="OUTSIDE" strokeWidth="0.0" text="0:00"/>
    </HBox>
    <HBox alignment="CENTER" spacing="5.0">
        <ImageView fitHeight="23.0" fitWidth="23.0" pickOnBounds="true" preserveRatio="true">
            <Image url="@../../images/volume-icon.png"/>
        </ImageView>
        <Slider fx:id="volumeSlider" prefHeight="16.0" prefWidth="100.0" stylesheets="@../../style/style.css"/>
    </HBox>
</VBox>
