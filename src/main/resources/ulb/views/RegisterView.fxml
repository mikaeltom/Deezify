<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:id="root" alignment="CENTER" maxHeight="Infinity" maxWidth="Infinity" prefHeight="485"
      prefWidth="710" spacing="50" styleClass="user-root" stylesheets="@../../style/style.css"
      xmlns="http://javafx.com/javafx/17.0.12" fx:controller="ulb.views.accounts.RegisterView">

    <HBox alignment="TOP_LEFT" spacing="10" HBox.hgrow="ALWAYS">
        <Button fx:id="backButton" styleClass="back-button" text="%back"/>
        <Region fx:id="spacer" HBox.hgrow="ALWAYS"/>
    </HBox>

    <Region prefHeight="5"/>

    <Label styleClass="auth-title" text="%register"/>

    <Region prefHeight="30"/>

    <VBox alignment="CENTER" spacing="15">
        <Label styleClass="input-label" text="%username"/>
        <TextField fx:id="usernameField" maxWidth="300" promptText="%enter_username" styleClass="auth-text-field"/>
    </VBox>

    <Region prefHeight="25"/>

    <VBox alignment="CENTER" spacing="15">
        <Label styleClass="input-label" text="%password"/>
        <PasswordField fx:id="passwordField" maxWidth="300" promptText="%enter_password"
                       styleClass="auth-password-field"/>
    </VBox>

    <Region prefHeight="25"/>

    <VBox alignment="CENTER" spacing="15">
        <Label styleClass="input-label" text="%confirm_password"/>
        <PasswordField fx:id="confirmPasswordField" maxWidth="300" promptText="%confirm_your_password"
                       styleClass="auth-password-field"/>
    </VBox>

    <Region prefHeight="25"/>

    <HBox alignment="CENTER" spacing="10">
        <CheckBox fx:id="keepLoggedCheckbox" styleClass="auth-check-box" stylesheets="@../../style/style.css"/>
        <Label styleClass="auth-check-box" text="%keep_logged"/>
    </HBox>

    <Region prefHeight="25"/>

    <VBox alignment="CENTER" spacing="15">
        <Button fx:id="profileImageButton" styleClass="account-settings-logout-button">
            <graphic>
                <HBox spacing="10">
                    <ImageView fitHeight="20" fitWidth="20" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@../../images/account-settings.png"/>
                        </image>
                    </ImageView>
                    <Label styleClass="logout-text" text="%select_profile_picture"/>
                </HBox>
            </graphic>
        </Button>
    </VBox>

    <Region prefHeight="25"/>

    <Button fx:id="registerButton" maxWidth="150" styleClass="auth-button" text="%register"/>

    <Region prefHeight="30"/>

    <Label fx:id="goToRegisterLabel" styleClass="register-label" text="%go_to_login"/>

</VBox>
